{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "semanticCommits": "disabled",
  "commitMessageLowerCase": "never",
  "commitMessagePrefix": "⬆️",
  "packageRules": [
    {
      "matchUpdateTypes": ["pin", "pinDigest"],
      "commitMessagePrefix": "📌"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track setuptools in pyproject.toml build-system (no native manager covers [build-system] requires)",
      "managerFilePatterns": ["/(^|/)pyproject\\.toml$/"],
      "matchStrings": ["requires\\s*=\\s*\\[\"(?<depName>setuptools)>=(?<currentValue>[^\"]+)\"\\]"],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440",
      "autoReplaceStringTemplate": "requires = [\"{{{depName}}}>={{{newValue}}}\"]"
    }
  ],
  "vulnerabilityAlerts": {
    "commitMessagePrefix": "🔒️"
  }
}
